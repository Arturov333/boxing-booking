rules_version = '2';

// Правила доступу до Firestore для сайту запису на тренування.
//
// Модель доступу:
//  • Клієнт (без входу): створює запис, бачить ЛИШЕ зайняті слоти (колекція
//    `slots` — локація/дата/час, без імен і телефонів), читає й залишає відгуки.
//  • Тренер (вхід через Firebase Auth, акаунт із UID у списку нижче): бачить і
//    змінює всі записи, керує розкладом і відгуками.
//
// Кожен запис = 2 документи з однаковим ID, що створюються одним batch:
//   bookings/{id} — повні дані (лише для тренера) + slots/{id} — публічний слот.

service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Встав сюди UID акаунта тренера
    // (Firebase Console → Authentication → Users → стовпець «User UID»).
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['PASTE_ADMIN_UID_HERE'];
    }

    function optStr(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }

    function validSlotFields(d) {
      return d.location in ['loc1', 'loc2']
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.time is string && d.time.matches('^[0-9]{2}:[0-9]{2}$');
    }

    // Запис клієнта з форми на сайті.
    function validClientBooking(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['location', 'date', 'time', 'name', 'phone',
                               'instagram', 'telegram', 'createdAt', 'status', 'pending'])
        && d.keys().hasAll(['location', 'date', 'time', 'name', 'phone', 'createdAt'])
        && validSlotFields(d)
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
        && d.phone is string && d.phone.size() >= 5 && d.phone.size() <= 30
        && optStr(d, 'instagram', 60)
        && optStr(d, 'telegram', 60)
        && d.createdAt == request.time
        && (!('status' in d) || d.status == 'request')
        && (!('pending' in d) || d.pending == true)
        // публічний слот створюється в тому ж batch
        && existsAfter(/databases/$(database)/documents/slots/$(id));
    }

    match /bookings/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || validClientBooking(id);
    }

    // Публічні зайняті слоти — без особистих даних.
    match /slots/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['location', 'date', 'time'])
        && validSlotFields(request.resource.data)
        // слот лише разом із новим записом з тими ж локацією/датою/часом
        && !exists(/databases/$(database)/documents/bookings/$(id))
        && getAfter(/databases/$(database)/documents/bookings/$(id)).data.location == request.resource.data.location
        && getAfter(/databases/$(database)/documents/bookings/$(id)).data.date == request.resource.data.date
        && getAfter(/databases/$(database)/documents/bookings/$(id)).data.time == request.resource.data.time
      );
      allow update, delete: if isAdmin();
    }

    // Відгуки: читають і залишають усі; змінює порядок і видаляє тренер.
    match /reviews/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['name', 'text', 'rating', 'order', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'text', 'rating', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5 && request.resource.data.text.size() <= 1500
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && (!('order' in request.resource.data) || request.resource.data.order is number)
        && request.resource.data.createdAt == request.time
      );
      allow update, delete: if isAdmin();
    }

    // Налаштування сайту (розклад залів) — читають усі, змінює лише тренер.
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
